rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().email.size() <= 128;
      allow delete: if isOwner(userId);

      // Subcollection for receipts
      match /receipts/{receiptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(receiptId) &&
          incoming().userId == userId &&
          incoming().id is string &&
          incoming().createdAt is number;
        allow update: if isOwner(userId) &&
          isValidId(receiptId) &&
          incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(receiptId);
      }
    }
  }
}
